# Copy to `.env` and adjust. `.env` is git-ignored. Keep it local.

# App identity
APP_NAME=OpenCodeMeter
BUNDLE_ID=dev.local.opencode-meter

# Where `make install` and `run.sh` place the app
INSTALL_DIR=$HOME/Applications

# Code signing.
# "-" means ad-hoc signing (fine for personal use).
# For a notarized release put your own identity here, e.g.:
#   SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)
SIGNING_IDENTITY=-

# Upstream repository
GITHUB_REPO=https://github.com/MrShiroLu/opencodeUsage.git
